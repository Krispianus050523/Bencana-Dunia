								"api",
								"events"
							],
							"query": [
								{
									"key": "per_page",
									"value": "3"
								},
								{
									"key": "page",
									"value": "1"
								}
							]
						},
						"description": "Menguji custom pagination halaman pertama dengan per_page=3. Expected: 3 item di data, metadata total sesuai jumlah data."
