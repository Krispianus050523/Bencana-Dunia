							"raw": "{{base_url}}/api/events",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"events"
							]
						},
						"description": "Menguji default pagination tanpa query parameter. Expected: per_page=5, page=1, menampilkan 5 item pertama dengan metadata pagination."
					},
					"response": []
				},
				{
					"name": "M6-02. Custom Page & Per Page (Page 1)",
